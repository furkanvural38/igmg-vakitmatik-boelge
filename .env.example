# Kopie als .env.local anlegen (wird nicht eingecheckt).
# In CI kommen die Werte aus GitHub-Secrets, siehe .github/workflows/deploy-pages.yml.

# Gebetszeiten-API. Ohne Angabe wird der Produktionsserver benutzt.
VITE_API_BASE=https://igmg-namaz.synology.me:3838

# OpenWeather. Ein Client-Key ist im Bundle IMMER öffentlich lesbar –
# im OpenWeather-Dashboard auf die Anzeige-Domain einschränken und rotieren,
# sobald er einmal in einem Commit gestanden hat.
VITE_OPENWEATHER_API_KEY=

# Optional: abweichender Endpunkt für den Tagesinhalt.
# VITE_DAILY_CONTENT_URL=
